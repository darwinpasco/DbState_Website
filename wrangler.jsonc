{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dbstate-website",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-22",
  "vars": {
    "PRIVATE_BETA_INTAKE_MODE": "disabled",
    "PRIVATE_BETA_NOTIFICATION_TO": "darwin@dbstate.com",
    "PRIVATE_BETA_EMAIL_FROM": "private-beta@dbstate.com",
    "PRIVATE_BETA_EMAIL_REPLY_TO": "darwin@dbstate.com",
    "PRIVATE_BETA_RETENTION_ENFORCEMENT_MODE": "disabled",
    "PRIVATE_BETA_RETENTION_BATCH_SIZE": "100",
    "TURNSTILE_EXPECTED_ACTION": "private-beta-application",
    "TURNSTILE_EXPECTED_HOSTNAMES": "dbstate.com,www.dbstate.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAD7ybcKG7AdVbfGm",
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY"],
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/private-beta-applications"],
  },
  "d1_databases": [
    {
      "binding": "PRIVATE_BETA_DB",
      "database_name": "dbstate-private-beta",
      "database_id": "97cd3f79-cc4a-4b05-a397-05d6057ab38e",
      "preview_database_id": "5b3e215c-0ecb-40eb-a4c4-794f913c9cee",
      "migrations_dir": "migrations",
    },
  ],
  "send_email": [
    {
      "name": "PRIVATE_BETA_EMAIL",
      "destination_address": "darwin@dbstate.com",
      "allowed_sender_addresses": ["private-beta@dbstate.com"],
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
}
