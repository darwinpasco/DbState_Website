{
  "name": "dbstate-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/astro-command.mjs dev",
    "build": "node ./scripts/astro-command.mjs build",
    "preview": "npm run build && wrangler dev",
    "preview:astro": "node ./scripts/astro-command.mjs preview --host 127.0.0.1 --port 4321",
    "check": "node ./scripts/astro-command.mjs check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run check && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:private-beta-client": "node ./scripts/playwright-private-beta-client.mjs",
    "test:e2e:private-beta-client:headed": "node ./scripts/playwright-private-beta-client.mjs --headed",
    "test:e2e:install": "playwright install chromium",
    "test:worker": "node ./scripts/worker-test-command.mjs run",
    "test:worker:watch": "node ./scripts/worker-test-command.mjs",
    "generate:worker-types": "wrangler types",
    "validate:wrangler-config": "node ./scripts/validate-wrangler-config.mjs",
    "d1:migrations:list:preview": "wrangler d1 migrations list PRIVATE_BETA_DB --remote --preview",
    "d1:migrations:apply:preview": "wrangler d1 migrations apply PRIVATE_BETA_DB --remote --preview",
    "d1:migrations:list:production": "wrangler d1 migrations list PRIVATE_BETA_DB --remote",
    "d1:migrations:apply:production": "wrangler d1 migrations apply PRIVATE_BETA_DB --remote",
    "capture:social-preview": "node ./scripts/capture-home-social-preview.mjs",
    "quality": "npm run validate && npm run validate:wrangler-config && npm run test:worker && npm run test:e2e",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "@playwright/test": "^1.61.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  }
}
