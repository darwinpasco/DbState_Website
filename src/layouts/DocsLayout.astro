---
import DocsPager from "../components/docs/DocsPager.astro";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import BaseLayout from "./BaseLayout.astro";
import type { DocsEntry, DocsNavigationGroup } from "../utils/docs";

type Props = {
  title: string;
  description: string;
  section: string;
  canonicalPath: string;
  groups: DocsNavigationGroup[];
  currentSlug: string;
  previous?: DocsEntry;
  next?: DocsEntry;
};

const {
  title,
  description,
  section,
  canonicalPath,
  groups,
  currentSlug,
  previous,
  next,
} = Astro.props;
---

<BaseLayout
  title={`${title} | DbState Docs`}
  description={description}
  canonicalPath={canonicalPath}
>
  <section
    class="mx-auto w-full max-w-[var(--db-content-width)] px-[var(--db-space-page)] py-10 md:py-14"
  >
    <div class="grid gap-8 lg:grid-cols-[18rem_minmax(0,1fr)] lg:items-start">
      <aside class="lg:sticky lg:top-24">
        <DocsSidebar groups={groups} currentSlug={currentSlug} />
      </aside>

      <article
        class="min-w-0 rounded-lg border border-border bg-bg-muted/60 p-5 md:p-8"
      >
        <header class="mb-8 border-b border-border pb-6">
          <p
            class="font-mono text-xs font-semibold uppercase tracking-normal text-accent"
          >
            {section}
          </p>
          <h1
            class="mt-3 max-w-[var(--db-reading-width)] text-3xl font-semibold text-text md:text-4xl"
          >
            {title}
          </h1>
          <p
            class="mt-4 max-w-[var(--db-reading-width)] text-base leading-7 text-text-muted md:text-lg"
          >
            {description}
          </p>
        </header>

        <div class="docs-article">
          <slot />
        </div>

        <DocsPager previous={previous} next={next} />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .docs-article {
    max-width: var(--db-reading-width);
    color: var(--db-color-text-muted);
    line-height: 1.75;
  }

  .docs-article :global(h2),
  .docs-article :global(h3) {
    color: var(--db-color-text);
    font-weight: 650;
    line-height: 1.25;
  }

  .docs-article :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.85rem;
    font-size: 1.55rem;
  }

  .docs-article :global(h2:first-child) {
    margin-top: 0;
  }

  .docs-article :global(h3) {
    margin-top: 1.8rem;
    margin-bottom: 0.55rem;
    font-size: 1.1rem;
  }

  .docs-article :global(p) {
    margin-top: 1rem;
  }

  .docs-article :global(ul),
  .docs-article :global(ol) {
    margin-top: 1rem;
    padding-left: 1.35rem;
  }

  .docs-article :global(li) {
    margin-top: 0.45rem;
  }

  .docs-article :global(a) {
    color: var(--db-color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .docs-article :global(code) {
    border: 1px solid var(--db-color-border);
    border-radius: var(--db-radius-sm);
    background: var(--db-color-surface);
    color: var(--db-color-text);
    font-family: var(--db-font-mono);
    font-size: 0.9em;
    padding: 0.12rem 0.28rem;
  }

  .docs-article :global(pre) {
    margin-top: 1rem;
    overflow-x: auto;
    border: 1px solid var(--db-color-border);
    border-radius: var(--db-radius-md);
    background: #050c13;
    padding: 1rem;
  }

  .docs-article :global(pre code) {
    border: 0;
    background: transparent;
    padding: 0;
    color: var(--db-color-text);
    white-space: pre;
  }

  .docs-article :global(blockquote) {
    margin-top: 1.25rem;
    border-left: 3px solid var(--db-color-review);
    border-radius: var(--db-radius-sm);
    background: var(--db-color-review-soft);
    padding: 0.85rem 1rem;
    color: var(--db-color-text);
  }

  .docs-article :global(blockquote p:first-child) {
    margin-top: 0;
  }

  .docs-article :global(table) {
    margin-top: 1rem;
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .docs-article :global(th),
  .docs-article :global(td) {
    border: 1px solid var(--db-color-border);
    padding: 0.6rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }

  .docs-article :global(th) {
    background: var(--db-color-surface);
    color: var(--db-color-text);
  }
</style>
