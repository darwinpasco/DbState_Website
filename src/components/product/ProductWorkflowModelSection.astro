---
import { workflowRows } from "../../data/productPage";
import SectionContainer from "../layout/SectionContainer.astro";
import SectionHeading from "../layout/SectionHeading.astro";
import StatusBadge from "../ui/StatusBadge.astro";
---

<SectionContainer id="workflow-model" ariaLabelledby="workflow-model-heading">
  <SectionHeading
    id="workflow-model-heading"
    eyebrow="Workflow model"
    title="Four workflows, each with an explicit direction."
    description="DbState separates schema from reference data and separates repository file writes from read-only database comparison. The direction is part of the workflow, not an implicit side effect."
  />

  <div class="mt-8 rounded-lg border border-border bg-surface p-3 md:p-4">
    <div
      class="hidden gap-3 border-b border-border pb-3 md:grid md:grid-cols-[11rem_minmax(0,1fr)_minmax(0,1fr)]"
      aria-hidden="true"
    >
      <div class="font-mono text-xs uppercase tracking-normal text-text-soft">
        State type
      </div>
      <div class="font-mono text-xs uppercase tracking-normal text-accent">
        Database to Repository
      </div>
      <div class="font-mono text-xs uppercase tracking-normal text-review">
        Repository to Database
      </div>
    </div>

    <div class="grid gap-4 pt-0 md:pt-4">
      {
        workflowRows.map((row) => (
          <section
            class="grid gap-3 md:grid-cols-[11rem_minmax(0,1fr)_minmax(0,1fr)]"
            aria-labelledby={`${row.stateType.toLowerCase().replace(" ", "-")}-workflow-row`}
          >
            <div class="rounded-md border border-border bg-bg-muted p-4">
              <p class="font-mono text-xs uppercase tracking-normal text-text-soft">
                State type
              </p>
              <h3
                id={`${row.stateType.toLowerCase().replace(" ", "-")}-workflow-row`}
                class="mt-2 text-xl font-semibold text-text"
              >
                {row.stateType}
              </h3>
            </div>

            {row.workflows.map((workflow) => (
              <article class="rounded-md border border-border bg-bg-muted p-4">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="font-mono text-xs uppercase tracking-normal text-text-soft md:hidden">
                      {workflow.direction}
                    </p>
                    <h4 class="mt-1 text-base font-semibold leading-6 text-text md:mt-0">
                      {workflow.title}
                    </h4>
                  </div>
                  <StatusBadge
                    label={workflow.label}
                    tone={
                      workflow.direction === "Database to Repository"
                        ? "safe"
                        : "review"
                    }
                  />
                </div>

                <dl class="mt-4 grid gap-2 font-mono text-xs">
                  <div class="grid gap-1 rounded-sm border border-border bg-surface px-3 py-2">
                    <dt class="uppercase tracking-normal text-text-soft">
                      Direction
                    </dt>
                    <dd class="break-words text-text-muted">
                      {workflow.direction}
                    </dd>
                  </div>
                  <div class="grid gap-1 rounded-sm border border-border bg-surface px-3 py-2">
                    <dt class="uppercase tracking-normal text-text-soft">
                      Source
                    </dt>
                    <dd class="break-words text-text-muted">
                      {workflow.source}
                    </dd>
                  </div>
                  <div class="grid gap-1 rounded-sm border border-border bg-surface px-3 py-2">
                    <dt class="uppercase tracking-normal text-text-soft">
                      Target
                    </dt>
                    <dd class="break-words text-text-muted">
                      {workflow.target}
                    </dd>
                  </div>
                </dl>

                <div class="mt-4 grid gap-3">
                  <div>
                    <p class="font-mono text-xs uppercase tracking-normal text-text-soft">
                      Purpose
                    </p>
                    <p class="mt-1 text-sm leading-6 text-text-muted">
                      {workflow.purpose}
                    </p>
                  </div>
                  <div>
                    <p class="font-mono text-xs uppercase tracking-normal text-text-soft">
                      Output
                    </p>
                    <p class="mt-1 text-sm leading-6 text-text-muted">
                      {workflow.output}
                    </p>
                  </div>
                  <div class="rounded-sm border border-border-strong bg-surface px-3 py-2">
                    <p class="font-mono text-xs uppercase tracking-normal text-text-soft">
                      Safety boundary
                    </p>
                    <p class="mt-1 text-sm leading-6 text-text-muted">
                      {workflow.safety}
                    </p>
                  </div>
                </div>
              </article>
            ))}
          </section>
        ))
      }
    </div>
  </div>
</SectionContainer>
