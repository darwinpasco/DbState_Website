---
import { productBetaScope } from "../../data/productPage";
import SectionContainer from "../layout/SectionContainer.astro";
import CtaLink from "../ui/CtaLink.astro";
import StatusBadge from "../ui/StatusBadge.astro";
---

<SectionContainer ariaLabelledby="product-beta-heading" class="pb-20 md:pb-28">
  <div class="rounded-lg border border-border-strong bg-surface p-5 md:p-8">
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="max-w-3xl">
        <p
          class="font-mono text-xs font-semibold uppercase tracking-normal text-accent"
        >
          Private Beta
        </p>
        <h2
          id="product-beta-heading"
          class="mt-3 text-2xl font-semibold text-text md:text-3xl"
        >
          Evaluate DbState with a real PostgreSQL workflow.
        </h2>
        <p class="mt-4 text-base leading-7 text-text-muted md:text-lg">
          The current Private Beta is intended for developers, database
          engineers, and technical teams actively managing PostgreSQL schema or
          reference-data changes through Git.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {
            productBetaScope.map((item) => (
              <StatusBadge
                label={item}
                tone={
                  item === "Review-only release artifacts"
                    ? "review"
                    : "neutral"
                }
              />
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
        <CtaLink href="/private-beta" label="Request Private Beta Access" />
        <CtaLink
          href="/safety"
          label="Review the safety model"
          variant="quiet"
        />
      </div>
    </div>
  </div>
</SectionContainer>
