---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  id: string;
  title: string;
  description: string;
  alt: string;
  image: ImageMetadata;
  loading?: "eager" | "lazy";
  sizes?: string;
};

const {
  id,
  title,
  description,
  alt,
  image,
  loading = "lazy",
  sizes = "(min-width: 1180px) 640px, calc(100vw - 2rem)",
} = Astro.props;
---

<figure
  class="overflow-hidden rounded-lg border border-border bg-surface"
  aria-labelledby={`${id}-screenshot-title`}
  aria-describedby={`${id}-screenshot-description`}
>
  <a
    href={image.src}
    aria-label={`Open full-size ${title} screenshot`}
    class="block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
  >
    <Image
      src={image}
      alt={alt}
      width={1600}
      height={1000}
      quality={92}
      loading={loading}
      decoding="async"
      class="aspect-[16/10] h-auto w-full max-w-full border-b border-border bg-bg-muted object-contain"
      sizes={sizes}
    />
  </a>
  <figcaption class="p-4">
    <h3 id={`${id}-screenshot-title`} class="text-base font-semibold text-text">
      {title}
    </h3>
    <p
      id={`${id}-screenshot-description`}
      class="mt-2 text-sm leading-6 text-text-muted"
    >
      {description}
    </p>
    <a
      href={image.src}
      class="mt-4 inline-block font-mono text-xs font-semibold uppercase tracking-normal text-accent underline decoration-border underline-offset-4 hover:text-accent-strong"
    >
      Open full-size {title} screenshot
    </a>
  </figcaption>
</figure>
