---
import { releasePlanSteps } from "../../data/productPage";
import { productScreenshots } from "../../data/productScreenshots";
import SectionContainer from "../layout/SectionContainer.astro";
import SectionHeading from "../layout/SectionHeading.astro";
import ProductScreenshotFigure from "./ProductScreenshotFigure.astro";

const releasePlanScreenshot = productScreenshots.find(
  (screenshot) => screenshot.id === "release-plan",
);
---

<SectionContainer ariaLabelledby="release-plan-heading">
  <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
    <div>
      <SectionHeading
        id="release-plan-heading"
        eyebrow="Release Plans"
        title="Prepare the handoff without taking over execution."
        description="Repository-to-Database schema comparison can lead into a Release Plan. Reviewers select supported candidates, inspect the handoff, and keep database execution in their normal release process outside DbState."
      />

      <ol class="mt-6 grid gap-2">
        {
          releasePlanSteps.map((step, index) => (
            <li class="grid grid-cols-[2.25rem_minmax(0,1fr)] gap-3 rounded-md border border-border bg-surface p-3">
              <span class="font-mono text-xs font-semibold text-accent">
                {(index + 1).toString().padStart(2, "0")}
              </span>
              <span class="text-sm leading-6 text-text-muted">{step}</span>
            </li>
          ))
        }
      </ol>

      <aside
        class="mt-5 rounded-lg border border-border-strong bg-bg-muted p-4"
      >
        <p
          class="font-mono text-xs font-semibold uppercase tracking-normal text-text-soft"
        >
          Review-only surface
        </p>
        <p class="mt-3 text-sm leading-6 text-text-muted">
          The current screenshot shows the real Release Plan review surface. It
          does not show generated release artifacts, generated SQL, SQL
          execution, or database mutation.
        </p>
        <p class="mt-3 text-sm leading-6 text-text-muted">
          Destructive or unsupported cases remain manual-review cases.
        </p>
      </aside>
    </div>

    {
      releasePlanScreenshot && (
        <ProductScreenshotFigure
          id="product-release-plan"
          title={releasePlanScreenshot.title}
          description={releasePlanScreenshot.description}
          alt={releasePlanScreenshot.alt}
          image={releasePlanScreenshot.image}
          sizes="(min-width: 1180px) 720px, calc(100vw - 2rem)"
        />
      )
    }
  </div>
</SectionContainer>
