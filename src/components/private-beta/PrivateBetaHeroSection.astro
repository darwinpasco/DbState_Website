---
import SectionContainer from "../layout/SectionContainer.astro";
import CtaLink from "../ui/CtaLink.astro";
import StatusBadge from "../ui/StatusBadge.astro";
---

<SectionContainer class="pt-16 md:pt-24" ariaLabelledby="private-beta-heading">
  <div
    class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.58fr)] lg:items-center"
  >
    <div class="max-w-3xl">
      <p
        class="font-mono text-xs font-semibold uppercase tracking-normal text-accent"
      >
        DbState Private Beta
      </p>
      <h1
        id="private-beta-heading"
        class="mt-4 text-4xl font-semibold tracking-normal text-text md:text-6xl"
      >
        Evaluate DbState with a real PostgreSQL workflow.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-text-muted">
        The DbState Private Beta is for developers, database engineers, and
        technical teams that want PostgreSQL database state in Git without
        handing database execution or Git history to the tool.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <CtaLink href="#application" label="Review the application questions" />
        <CtaLink
          href="/product"
          label="Explore the Product"
          variant="secondary"
        />
      </div>
      <p class="mt-5 font-mono text-sm text-text-soft">
        PostgreSQL. Windows. Local workflow. Access by request.
      </p>
    </div>

    <aside
      class="rounded-lg border border-border bg-surface p-5"
      aria-label="Private Beta access summary"
    >
      <StatusBadge label="access by request" tone="review" />
      <dl class="mt-5 grid gap-3">
        <div class="rounded-md border border-border bg-bg-muted p-3">
          <dt
            class="font-mono text-xs uppercase tracking-normal text-text-soft"
          >
            Database
          </dt>
          <dd class="mt-1 text-sm font-semibold text-text">PostgreSQL</dd>
        </div>
        <div class="rounded-md border border-border bg-bg-muted p-3">
          <dt
            class="font-mono text-xs uppercase tracking-normal text-text-soft"
          >
            Platform
          </dt>
          <dd class="mt-1 text-sm font-semibold text-text">Windows</dd>
        </div>
        <div class="rounded-md border border-border-strong bg-bg-muted p-3">
          <dt
            class="font-mono text-xs uppercase tracking-normal text-text-soft"
          >
            Boundary
          </dt>
          <dd class="mt-1 text-sm font-semibold text-review">
            No direct database execution
          </dd>
        </div>
      </dl>
    </aside>
  </div>
</SectionContainer>
