---
import { evaluationWorkflows } from "../../data/privateBetaPage";
import SectionContainer from "../layout/SectionContainer.astro";
import SectionHeading from "../layout/SectionHeading.astro";
---

<SectionContainer ariaLabelledby="evaluation-workflows-heading">
  <SectionHeading
    id="evaluation-workflows-heading"
    eyebrow="Evaluation workflows"
    title="Bring a workflow that exposes the problem."
    description="A useful evaluation starts with a workflow that is already difficult to review, reproduce, or hand off safely."
  />

  <div class="mt-8 grid gap-3 md:grid-cols-2 xl:grid-cols-5">
    {
      evaluationWorkflows.map((workflow, index) => (
        <article class="rounded-lg border border-border bg-surface p-4">
          <p class="font-mono text-xs font-semibold text-accent">
            {(index + 1).toString().padStart(2, "0")}
          </p>
          <h3 class="mt-3 font-semibold leading-6 text-text">
            {workflow.title}
          </h3>
          <p class="mt-3 text-sm leading-6 text-text-muted">
            {workflow.description}
          </p>
        </article>
      ))
    }
  </div>

  <p class="mt-5 max-w-3xl text-sm leading-6 text-text-soft">
    Evaluation should focus on real comparison, review, and handoff behavior
    rather than assuming every selected candidate will produce an artifact.
  </p>
</SectionContainer>
