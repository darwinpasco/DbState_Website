---
import {
  recommendedEnvironment,
  requiredEnvironment,
} from "../../data/privateBetaPage";
import SectionContainer from "../layout/SectionContainer.astro";
import SectionHeading from "../layout/SectionHeading.astro";
import StatusBadge from "../ui/StatusBadge.astro";
---

<SectionContainer ariaLabelledby="technical-environment-heading">
  <SectionHeading
    id="technical-environment-heading"
    eyebrow="Evaluation environment"
    title="What you need to evaluate DbState."
    description="A useful Private Beta evaluation needs a real PostgreSQL workflow, a local repository for desired state, and a controlled environment where inspection and repository writes are appropriate."
  />

  <div class="mt-8 grid gap-4 lg:grid-cols-2">
    <article class="rounded-lg border border-border bg-surface p-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h3 class="font-semibold text-text">Required</h3>
        <StatusBadge label="needed for evaluation" tone="review" />
      </div>
      <ul class="mt-4 grid gap-2">
        {
          requiredEnvironment.map((item) => (
            <li class="rounded-sm border border-border bg-bg-muted px-3 py-2 text-sm leading-6 text-text-muted">
              {item}
            </li>
          ))
        }
      </ul>
    </article>

    <article class="rounded-lg border border-border bg-surface p-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h3 class="font-semibold text-text">Recommended</h3>
        <StatusBadge label="useful context" />
      </div>
      <ul class="mt-4 grid gap-2">
        {
          recommendedEnvironment.map((item) => (
            <li class="rounded-sm border border-border bg-bg-muted px-3 py-2 text-sm leading-6 text-text-muted">
              {item}
            </li>
          ))
        }
      </ul>
    </article>
  </div>

  <aside class="mt-5 rounded-lg border border-review/60 bg-review-soft p-4">
    <p
      class="font-mono text-xs font-semibold uppercase tracking-normal text-review"
    >
      Evaluation safety recommendation
    </p>
    <p class="mt-3 text-sm leading-6 text-text-muted">
      Do not use the Private Beta as an unreviewed production deployment
      mechanism.
    </p>
  </aside>
</SectionContainer>
