---
import SectionContainer from "../layout/SectionContainer.astro";
import SectionHeading from "../layout/SectionHeading.astro";
import StatusBadge from "../ui/StatusBadge.astro";
---

<SectionContainer ariaLabelledby="intake-status-heading">
  <div class="rounded-lg border border-border bg-surface p-5 md:p-6">
    <div class="grid gap-6 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
      <div>
        <SectionHeading
          id="intake-status-heading"
          eyebrow="Intake status"
          title="Application intake is currently closed."
        />
        <div class="mt-5">
          <StatusBadge label="intake closed" tone="review" />
        </div>
      </div>
      <div class="grid gap-4 text-sm leading-6 text-text-muted">
        <p>
          The application questionnaire is included so prospective participants
          can review the qualification criteria, but submission is not currently
          available.
        </p>
        <p>
          No information entered on this page is transmitted to or stored by
          DbState while application intake is closed.
        </p>
      </div>
    </div>
  </div>
</SectionContainer>
