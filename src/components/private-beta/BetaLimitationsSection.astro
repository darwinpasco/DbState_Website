---
import {
  betaIncluded,
  betaNotIncluded,
  postgresPrivateBetaLimitations,
} from "../../data/privateBetaPage";
import SectionContainer from "../layout/SectionContainer.astro";
import SectionHeading from "../layout/SectionHeading.astro";
import StatusBadge from "../ui/StatusBadge.astro";
---

<SectionContainer ariaLabelledby="beta-limitations-heading">
  <SectionHeading
    id="beta-limitations-heading"
    eyebrow="Known boundaries"
    title="Controlled scope, not hidden scope."
    description="Private Beta scope is intentionally bounded so DbState can focus on local PostgreSQL state review without implying hosted collaboration, direct execution, or automatic Git behavior."
  />

  <div class="mt-8 grid gap-4 lg:grid-cols-2">
    <article class="rounded-lg border border-border bg-surface p-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h3 class="font-semibold text-text">Included</h3>
        <StatusBadge label="current beta" tone="safe" />
      </div>
      <ul class="mt-4 grid gap-2">
        {
          betaIncluded.map((item) => (
            <li class="rounded-sm border border-border bg-bg-muted px-3 py-2 text-sm leading-6 text-text-muted">
              {item}
            </li>
          ))
        }
      </ul>
    </article>

    <article class="rounded-lg border border-border bg-surface p-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h3 class="font-semibold text-text">Not included</h3>
        <StatusBadge label="outside current beta" tone="review" />
      </div>
      <ul class="mt-4 grid gap-2">
        {
          betaNotIncluded.map((item) => (
            <li class="rounded-sm border border-border bg-bg-muted px-3 py-2 text-sm leading-6 text-text-muted">
              {item}
            </li>
          ))
        }
      </ul>
    </article>
  </div>

  <aside class="mt-4 rounded-lg border border-border bg-bg-muted p-4">
    <p
      class="font-mono text-xs font-semibold uppercase tracking-normal text-text-soft"
    >
      PostgreSQL object limitation
    </p>
    <p class="mt-3 text-sm leading-6 text-text-muted">
      {postgresPrivateBetaLimitations}
    </p>
  </aside>
</SectionContainer>
