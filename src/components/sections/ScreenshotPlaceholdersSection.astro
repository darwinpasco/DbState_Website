---
import { screenshotPlaceholders } from "../../data/homepage";
import SectionContainer from "../layout/SectionContainer.astro";
import SectionHeading from "../layout/SectionHeading.astro";
---

<SectionContainer ariaLabelledby="interface-heading">
  <SectionHeading
    id="interface-heading"
    eyebrow="Product interface"
    title="Screenshot slots reserved for real product captures."
    description="These framed placeholders mark the intended asset types for later replacement. They are intentionally not detailed mockups of the DbState interface."
  />
  <div class="mt-8 grid gap-4 md:grid-cols-2">
    {
      screenshotPlaceholders.map((label) => (
        <div class="min-h-48 rounded-md border border-border bg-surface p-4">
          <div class="flex items-center justify-between gap-4 border-b border-border pb-3">
            <span class="font-mono text-xs uppercase tracking-normal text-text-soft">
              placeholder
            </span>
            <span class="h-2 w-2 rounded-full bg-review" aria-hidden="true" />
          </div>
          <div class="flex min-h-32 items-center justify-center text-center">
            <p class="font-mono text-sm font-semibold text-text-muted">
              {label}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</SectionContainer>
