---
import SectionContainer from "../layout/SectionContainer.astro";
import SectionHeading from "../layout/SectionHeading.astro";
import StatusBadge from "../ui/StatusBadge.astro";
---

<SectionContainer ariaLabelledby="safety-heading">
  <div class="grid gap-8 lg:grid-cols-[1fr_0.8fr] lg:items-start">
    <SectionHeading
      id="safety-heading"
      eyebrow="Review-first safety"
      title="DbState prepares review context, not database deployment."
      description="Current safety commitments are treated as product boundaries. Release artifacts are generated for review and manual execution outside DbState."
    />
    <div class="rounded-lg border border-border bg-surface p-5">
      <div class="grid gap-3">
        <StatusBadge label="No direct database apply" tone="safe" />
        <StatusBadge label="No generated SQL execution" tone="safe" />
        <StatusBadge label="No automatic Git commits" tone="safe" />
        <StatusBadge label="Review-only release artifacts" tone="review" />
      </div>
    </div>
  </div>
</SectionContainer>
