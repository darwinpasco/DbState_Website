---
import SectionContainer from "../layout/SectionContainer.astro";
import SectionHeading from "../layout/SectionHeading.astro";
import StatusBadge from "../ui/StatusBadge.astro";
---

<SectionContainer ariaLabelledby="credential-handling-heading">
  <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
    <div>
      <SectionHeading
        id="credential-handling-heading"
        eyebrow="Credentials"
        title="Database passwords are not stored."
        description="DbState's local workflow keeps credential handling narrow. Saved connection profiles may retain non-secret connection settings, but PostgreSQL passwords are entered when needed."
      />
      <p
        class="mt-6 rounded-lg border border-border bg-surface p-4 text-sm leading-6 text-text-muted"
      >
        Local workflows reduce the need to transmit database credentials to a
        hosted DbState service.
      </p>
    </div>

    <article class="rounded-lg border border-border bg-surface p-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h3 class="font-semibold text-text">Credential boundary</h3>
        <StatusBadge label="no stored PostgreSQL passwords" tone="safe" />
      </div>
      <ul class="mt-4 grid gap-2">
        <li
          class="rounded-md border border-border bg-bg-muted px-3 py-2 text-sm leading-6 text-text-muted"
        >
          Saved connection profiles may retain non-secret connection settings.
        </li>
        <li
          class="rounded-md border border-border bg-bg-muted px-3 py-2 text-sm leading-6 text-text-muted"
        >
          PostgreSQL passwords are entered when needed.
        </li>
        <li
          class="rounded-md border border-border bg-bg-muted px-3 py-2 text-sm leading-6 text-text-muted"
        >
          DbState does not store PostgreSQL passwords.
        </li>
        <li
          class="rounded-md border border-border bg-bg-muted px-3 py-2 text-sm leading-6 text-text-muted"
        >
          Website screenshots and documentation must not expose credentials.
        </li>
      </ul>
    </article>
  </div>
</SectionContainer>
