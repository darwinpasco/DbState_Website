---
import { manualReviewExamples } from "../../data/safetyPage";
import SectionContainer from "../layout/SectionContainer.astro";
import SectionHeading from "../layout/SectionHeading.astro";
import StatusBadge from "../ui/StatusBadge.astro";
---

<SectionContainer ariaLabelledby="manual-review-heading">
  <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
    <div>
      <SectionHeading
        id="manual-review-heading"
        eyebrow="Manual review"
        title="Not every difference should become generated SQL."
        description="DbState does not pretend that every schema difference has a universally safe automated resolution. Manual review is an explicit outcome, not a hidden failure."
      />
      <div class="mt-6 grid gap-3">
        <div class="rounded-lg border border-border bg-surface p-4">
          <StatusBadge label="manual-review case" tone="review" />
          <p class="mt-4 text-sm leading-6 text-text-muted">
            Destructive SQL is not generated by default. Changed or
            database-only objects may remain manual-review cases.
          </p>
        </div>
        <div class="rounded-lg border border-border bg-surface p-4">
          <p
            class="font-mono text-xs font-semibold uppercase tracking-normal text-text-soft"
          >
            Capability scope
          </p>
          <p class="mt-3 text-sm leading-6 text-text-muted">
            Unsupported PostgreSQL object types remain outside automatic
            artifact preparation. Review current capability scope on the{" "}
            <a
              href="/product/"
              class="text-accent underline decoration-border underline-offset-4 hover:text-accent-strong"
            >
              Product page
            </a>
            .
          </p>
        </div>
      </div>
    </div>

    <article class="rounded-lg border border-border bg-surface p-4">
      <h3 class="font-semibold text-text">Destructive or sensitive examples</h3>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {
          manualReviewExamples.map((example) => (
            <li class="rounded-sm border border-border bg-bg-muted px-3 py-2 text-sm text-text-muted">
              {example}
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-sm leading-6 text-text-soft">
        This page is not an exhaustive release-artifact support matrix.
      </p>
    </article>
  </div>
</SectionContainer>
