---
import { artifactHandoffSteps } from "../../data/safetyPage";
import { productScreenshots } from "../../data/productScreenshots";
import ProductScreenshotFigure from "../product/ProductScreenshotFigure.astro";
import SectionContainer from "../layout/SectionContainer.astro";
import SectionHeading from "../layout/SectionHeading.astro";

const releasePlanScreenshot = productScreenshots.find(
  (screenshot) => screenshot.id === "release-plan",
);
---

<SectionContainer ariaLabelledby="artifact-handoff-heading">
  <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
    <div>
      <SectionHeading
        id="artifact-handoff-heading"
        eyebrow="Release handoff"
        title="Artifacts are prepared for review, not blind execution."
        description="The Release Plan review surface helps teams inspect selected candidates before any database execution occurs outside DbState."
      />

      <ol class="mt-6 grid gap-2">
        {
          artifactHandoffSteps.map((step, index) => (
            <li class="grid grid-cols-[2.25rem_minmax(0,1fr)] gap-3 rounded-md border border-border bg-surface p-3">
              <span class="font-mono text-xs font-semibold text-accent">
                {(index + 1).toString().padStart(2, "0")}
              </span>
              <span class="text-sm leading-6 text-text-muted">{step}</span>
            </li>
          ))
        }
      </ol>

      <aside
        class="mt-5 rounded-lg border border-border-strong bg-bg-muted p-4"
      >
        <p
          class="font-mono text-xs font-semibold uppercase tracking-normal text-text-soft"
        >
          Screenshot limitation
        </p>
        <p class="mt-3 text-sm leading-6 text-text-muted">
          The screenshot shows the real Release Plan review surface. It does not
          show successful release dry-run, completed artifact generation,
          generated SQL, SQL execution, or deployment.
        </p>
      </aside>
    </div>

    {
      releasePlanScreenshot && (
        <ProductScreenshotFigure
          id="safety-release-plan"
          title="Release Plan"
          description="Select supported release candidates and review the planned handoff before any database execution occurs outside DbState."
          alt={releasePlanScreenshot.alt}
          image={releasePlanScreenshot.image}
          sizes="(min-width: 1180px) 720px, calc(100vw - 2rem)"
        />
      )
    }
  </div>
</SectionContainer>
