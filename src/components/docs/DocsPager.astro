---
import { getDocsUrl, type DocsEntry } from "../../utils/docs";

type Props = {
  previous?: DocsEntry;
  next?: DocsEntry;
};

const { previous, next } = Astro.props;
---

{
  (previous || next) && (
    <nav
      aria-label="Documentation pagination"
      class="mt-10 grid gap-4 border-t border-border pt-6 md:grid-cols-2"
    >
      <div>
        {previous && (
          <a
            class="block h-full rounded-lg border border-border bg-surface p-4 transition-colors hover:border-accent hover:bg-surface-strong"
            href={getDocsUrl(previous)}
          >
            <span class="font-mono text-xs uppercase tracking-normal text-text-soft">
              Previous
            </span>
            <span class="mt-2 block font-semibold text-text">
              {previous.data.title}
            </span>
            <span class="mt-1 block text-sm leading-6 text-text-muted">
              {previous.data.description}
            </span>
          </a>
        )}
      </div>
      <div>
        {next && (
          <a
            class="block h-full rounded-lg border border-border bg-surface p-4 transition-colors hover:border-accent hover:bg-surface-strong md:text-right"
            href={getDocsUrl(next)}
          >
            <span class="font-mono text-xs uppercase tracking-normal text-text-soft">
              Next
            </span>
            <span class="mt-2 block font-semibold text-text">
              {next.data.title}
            </span>
            <span class="mt-1 block text-sm leading-6 text-text-muted">
              {next.data.description}
            </span>
          </a>
        )}
      </div>
    </nav>
  )
}
