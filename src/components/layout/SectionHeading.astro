---
type Props = {
  eyebrow?: string;
  title: string;
  description?: string;
  id?: string;
};

const { eyebrow, title, description, id } = Astro.props;
---

<div class="max-w-[var(--db-reading-width)]">
  {
    eyebrow && (
      <p class="mb-3 font-mono text-xs font-semibold uppercase tracking-normal text-accent">
        {eyebrow}
      </p>
    )
  }
  <h2 id={id} class="text-2xl font-semibold text-text md:text-3xl">
    {title}
  </h2>
  {
    description && (
      <p class="mt-4 text-base leading-7 text-text-muted md:text-lg">
        {description}
      </p>
    )
  }
</div>
