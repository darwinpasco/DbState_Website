---
import { getCollection } from "astro:content";
import CtaLink from "../../components/ui/CtaLink.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getDocsUrl,
  groupDocsBySection,
  getPublishedDocs,
} from "../../utils/docs";

const docs = getPublishedDocs(await getCollection("docs"));
const groups = groupDocsBySection(docs);
---

<BaseLayout
  title="DbState Documentation | Private Beta PostgreSQL workflows"
  description="Learn how to set up a DbState workspace, capture PostgreSQL state into repository files, compare desired state with a target database, review differences, and prepare controlled release handoffs."
  canonicalPath="/docs/"
>
  <section
    class="mx-auto w-full max-w-[var(--db-content-width)] px-[var(--db-space-page)] py-14 md:py-20"
  >
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
      <div>
        <p
          class="font-mono text-xs font-semibold uppercase tracking-normal text-accent"
        >
          DbState Documentation
        </p>
        <h1
          class="mt-4 max-w-3xl text-4xl font-semibold tracking-normal text-text md:text-5xl"
        >
          Work with database state through explicit Git-managed workflows.
        </h1>
        <p
          class="mt-5 max-w-[var(--db-reading-width)] text-lg leading-8 text-text-muted"
        >
          Learn how to set up a DbState workspace, capture PostgreSQL state into
          repository files, compare desired state with a target database, review
          differences, and prepare controlled release handoffs.
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <CtaLink href="/docs/getting-started/" label="Getting Started" />
          <CtaLink
            href="/docs/safety-model/"
            label="Review the Safety Model"
            variant="secondary"
          />
        </div>
      </div>

      <aside class="rounded-lg border border-border bg-surface p-5">
        <p
          class="font-mono text-xs font-semibold uppercase tracking-normal text-safe"
        >
          Current scope
        </p>
        <p class="mt-3 text-base font-semibold text-text">
          Private Beta documentation for PostgreSQL and Windows.
        </p>
        <p class="mt-3 text-sm leading-6 text-text-muted">
          The documentation reflects local developer workflows, repository
          desired state, explicit repository writes, and review-only release
          artifacts.
        </p>
      </aside>
    </div>
  </section>

  <section
    class="mx-auto w-full max-w-[var(--db-content-width)] px-[var(--db-space-page)] pb-16 md:pb-24"
  >
    <div class="rounded-lg border border-border bg-bg-muted/70 p-5 md:p-8">
      <div class="max-w-[var(--db-reading-width)]">
        <p
          class="font-mono text-xs font-semibold uppercase tracking-normal text-text-soft"
        >
          Documentation map
        </p>
        <h2 class="mt-3 text-2xl font-semibold text-text md:text-3xl">
          Start with setup, then follow the workflow boundaries.
        </h2>
      </div>

      <div class="mt-8 divide-y divide-border">
        {
          groups.map((group) => (
            <section class="grid gap-4 py-6 first:pt-0 last:pb-0 md:grid-cols-[12rem_minmax(0,1fr)]">
              <h3 class="font-mono text-sm font-semibold uppercase tracking-normal text-accent">
                {group.section}
              </h3>
              <div class="grid gap-3">
                {group.entries.map((entry) => (
                  <a
                    class="rounded-lg border border-border bg-surface p-4 transition-colors hover:border-accent hover:bg-surface-strong"
                    href={getDocsUrl(entry)}
                  >
                    <span class="block text-base font-semibold text-text">
                      {entry.data.title}
                    </span>
                    <span class="mt-1 block text-sm leading-6 text-text-muted">
                      {entry.data.description}
                    </span>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
